YOUTUBE_API_KEY=your-youtube-data-api-key
GEMINI_API_KEY=your-gemini-api-key

# Optional: use a Webshare Residential plan when YouTube blocks the server IP.
YOUTUBE_PROXY_USERNAME=your-webshare-proxy-username
YOUTUBE_PROXY_PASSWORD=your-webshare-proxy-password

# Optional Gemini model override.
GEMINI_MODEL=gemini-3.1-flash-lite
