YOUTUBE_API_KEY=your-youtube-data-api-key
GEMINI_API_KEY=your-gemini-api-key
SERPAPI_KEY=your-serpapi-key

# Optional: use a Webshare Residential plan when YouTube blocks the server IP.
YOUTUBE_PROXY_USERNAME=your-webshare-proxy-username
YOUTUBE_PROXY_PASSWORD=your-webshare-proxy-password

# Optional Gemini model override.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: bypass YouTube and return clearly labeled local fixture data.
YOUTUBE_TEST_DATA=false

# Optional private model services, normally injected by the Vultr deployment.
EMBEDDING_BASE_URL=http://127.0.0.1:8080
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
CLASSIFICATION_ENABLED=false
CLASSIFICATION_BASE_URL=http://127.0.0.1:8081
CLASSIFICATION_MODEL_ID=SamLowe/roberta-base-go_emotions
